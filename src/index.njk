---
title: SIGMOD logo proposals
permalink: /
---
{%- from "logos.njk" import wordmark, wordmarkIcon, mark, r4Defs, r4Mark, r4Lockup, joinWordmark, joinIcon, joinOdWordmark, joinMIcon, sigmaDbWordmark, dbIcon, joinLeadWordmark -%}
{%- set blue = "#1f4fa3" %}{% set blueDark = "#8fb0ff" -%}
<style>
.lp-concept { border: 1px solid #e5e7eb; border-radius: 14px; padding: 28px; margin: 0 0 36px; background: #fff; }
.lp-concept h2 { margin: 0 0 4px !important; }
.lp-concept > p { margin: 0 0 20px; max-width: 680px; }
.lp-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
.lp-cell { border-radius: 10px; padding: 18px 20px; display: flex; align-items: center; gap: 20px; flex-wrap: wrap; min-height: 96px; }
.lp-wide { grid-column: 1 / -1; }
.lp-cell-label { width: 100%; margin: 0 0 -6px; font-size: 11.5px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: #6b7280; }
.lp-light { background: #fff; border: 1px solid #e5e7eb; }
.lp-dark { background: #0a0a0a; }
.lp-dark .lp-cell-label { color: #737373; }
.lp-tint { background: #f3f6fb; }
.lp-navmock { display: flex; align-items: center; gap: 18px; width: 100%; }
.lp-navmock i { font-style: normal; font-size: 13.5px; color: #374151; }
.lp-navmock i:first-of-type { margin-left: auto; }
.lp-icons { display: flex; align-items: flex-end; gap: 16px; }
.lp-icons span { display: grid; place-items: center; border-radius: 12px; background: #fff; border: 1px solid #e5e7eb; }
.lp-tag { display: flex; align-items: center; gap: 16px; }
.lp-tag small { font: 500 13px/1.3 "Inter", sans-serif; color: #4b5563; padding-left: 16px; border-left: 1px solid #cbd5e1; }
.lp-current { display: flex; gap: 24px; align-items: center; flex-wrap: wrap; }
.lp-current img { border: 1px solid #e5e7eb; border-radius: 8px; padding: 12px; background: #fff; }
.lp-overview { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 12px; margin: 0 0 36px; }
.lp-overview a { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; padding: 22px 10px 14px; border: 1px solid #e5e7eb; border-radius: 12px; text-decoration: none; color: #6b7280; font-size: 13px; font-weight: 600; background: #fff; }
.lp-overview a:hover { border-color: #1f4fa3; }
.lp-round { font-size: 13px !important; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: #6b7280 !important; margin: 44px 0 14px !important; }
.lp-pick { display: inline-block; margin-left: 8px; font-size: 11px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: #fff; background: #1f4fa3; border-radius: 4px; padding: 2px 7px; vertical-align: middle; }
.lp-strip { display: flex; flex-wrap: wrap; gap: 14px; }
.lp-notes { font-size: 14.5px; color: #4b5563; margin: 16px 0 0; padding-left: 18px; }

/* wordmarks */
.wm { display: inline-flex; align-items: baseline; font: 800 40px/1 "Inter Tight", sans-serif; letter-spacing: -.015em; color: var(--ink); white-space: nowrap; flex: none; }
.wm-g { height: .73em; flex: none; margin: 0 .025em; }
.wm-gap { margin: 0 .07em; }
.wm-tile { align-items: center; gap: .3em; }
.wm-tile .wm-word { font-weight: 700; letter-spacing: -.01em; }
.wm-tuple { font-family: "IBM Plex Mono", monospace; font-weight: 600; font-size: .82em; letter-spacing: 0; border: 2px solid var(--c); border-radius: .18em; overflow: hidden; }
.wm-tuple b { font-weight: inherit; padding: .14em .2em .12em; border-left: 1.5px solid color-mix(in srgb, var(--c) 35%, transparent); }
.wm-tuple b:first-child { border-left: 0; }
.wm-tuple b.on { background: var(--c); color: #fff; }
.lp-dark .wm-tuple b.on { color: #0a0a0a; }
/* round 5 */
.r5 { display: inline-flex; align-items: baseline; flex: none; white-space: nowrap; font-family: "Jost", sans-serif; letter-spacing: .1em; color: #1f2937; line-height: 1; }
.r6-i { width: 1.25em; height: 1em; margin-right: .32em; align-self: center; flex: none; overflow: visible; }
.r7-g { height: .7em; margin: 0 .1em 0 0; flex: none; overflow: visible; }
.r6-m { width: 1.01em; height: .7em; margin: 0 .12em 0 .01em; flex: none; overflow: visible; }
.r5-j { width: 1.05em; height: .85em; margin: 0 .16em 0 .06em; align-self: center; position: relative; top: -.04em; overflow: visible; }
.lp-hero-mark { display: grid; place-items: center; gap: 14px; padding: 48px 20px; border-radius: 14px; background: #fff; border: 1px solid #e5e7eb; margin: 0 0 36px; text-align: center; }
.lp-hero-mark small { font: 400 14px "Jost", sans-serif; letter-spacing: .14em; text-transform: uppercase; color: #6b7280; }
/* round 4 */
.r4 { display: inline-flex; align-items: center; gap: .35em; flex: none; white-space: nowrap; color: #1f2937; }
.r4-v { flex-direction: column; gap: .35em; }
.r4-name { font: 400 1em/1 "Jost", sans-serif; letter-spacing: .1em; display: inline-flex; align-items: baseline; }
.r4-acm { font-weight: 300; margin-right: .35em; opacity: .75; }
.r4-dark { color: #fff; }
.r4-o { width: .875em; height: .875em; vertical-align: -.05em; align-self: baseline; margin: 0 .02em; position: relative; top: .05em; }
.lp-r4 .lp-overview a { min-height: 120px; }
.lp-four { grid-template-columns: repeat(4, minmax(0, 1fr)); }
@media (max-width: 760px) { .lp-four { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (max-width: 760px) { .lp-grid { grid-template-columns: 1fr; } .lp-concept { padding: 18px; } .lp-navmock i { display: none; } .lp-tag { flex-wrap: wrap; } .lp-tag small { border: 0; padding: 0; } }
</style>

{{ r4Defs() }}
{%- macro logo(k, dark=false, size=26, weight=400) -%}
{%- if k.kind == "lead" %}{{ joinLeadWordmark(dark, size, weight) }}
{%- elif k.kind == "m" %}{{ joinOdWordmark(k.style, dark, size, weight) }}
{%- elif k.kind == "sigma" %}{{ sigmaDbWordmark(dark, size, weight) }}
{%- else %}{{ joinWordmark(k.style, dark, size, weight) }}{% endif -%}
{%- endmacro %}
{%- macro icon(k, size, dark=false) -%}
{%- if k.kind == "m" %}{{ joinMIcon(k.style, size, dark) }}
{%- elif k.kind == "sigma" %}{{ dbIcon(size, dark) }}
{%- else %}{{ joinIcon(k.style, size, dark) }}{% endif -%}
{%- endmacro %}
<p class="lead">Four candidates for the new logo, all built on the same ribbon-drawn join (⋈) and none with “ACM” in the logo itself. They differ in where the join sits and how much of the name it replaces. Until one is chosen, sigmod.org keeps the current 1998 logo. Earlier ideas are listed under “Prior approaches” below.</p>

{%- set concepts = [
  { id: "join-sigmod", kind: "lead", style: "ribbon", name: "⋈ SIGMOD", text: "The join as a symbol in front of the full name, the way SIGARCH and SIGCHI pair a mark with a wordmark. The name stays fully readable, and the symbol works on its own as the icon, avatar or favicon." },
  { id: "ribbon", kind: "mid", style: "ribbon", name: "SIG⋈MOD", text: "The join between SIG and MOD, drawn as one continuous, softly curved line, like a ribbon folded into ⋈. It joins the two halves of the name, which is what the operator does." },
  { id: "join-m", kind: "m", style: "ribbon", name: "SIG⋈OD", text: "The same join, drawn at the height of a capital letter and standing in for the M. The join becomes part of the name rather than a symbol between two halves. People still read “SIGMOD”, so the accessible name stays SIGMOD." },
  { id: "sigma-db", kind: "sigma", style: "ribbon", name: "SIG⋈σ + database", text: "SIG followed by relational algebra and a database: the join (⋈), the selection operator (σ) and a database cylinder. It spells out what the community works on, at the cost of being read as symbols rather than as “SIGMOD”." }
] %}

<div class="lp-overview lp-four">
  {%- for k in concepts %}<a href="#{{ k.id }}">{{ logo(k, false, 20) }}<span>{{ loop.index }} · {{ k.name }}</span></a>{% endfor %}
</div>

{%- for k in concepts %}
<section class="lp-concept" id="{{ k.id }}">
  <h2>{{ loop.index }} · {{ k.name }}{% if k.pick %}<span class="lp-pick">{{ k.pick }}</span>{% endif %}</h2>
  <p>{{ k.text }}</p>
  <div class="lp-grid">
    <div class="lp-cell lp-light">
      <p class="lp-cell-label">In the navigation bar</p>
      <div class="lp-navmock">{{ logo(k, false, 26) }}<i>About</i><i>Awards</i><i>PODS</i></div>
    </div>
    <div class="lp-cell lp-dark">
      <p class="lp-cell-label">On the black footer</p>
      {{ logo(k, true, 26) }}
    </div>
    <div class="lp-cell lp-tint">
      <p class="lp-cell-label">Weights: light · regular · medium</p>
      {{ logo(k, false, 22, 300) }}{{ logo(k, false, 22, 400) }}{{ logo(k, false, 22, 500) }}
    </div>
    <div class="lp-cell lp-light">
      <p class="lp-cell-label">Icon (64 · 32 · 16 px)</p>
      <div class="lp-icons">
        {%- for s in [64, 32, 16] %}
        <span style="width: {{ s + 16 }}px; height: {{ s + 16 }}px">{{ icon(k, s) }}</span>
        {%- endfor %}
        <span style="width: 80px; height: 80px; background: #0a0a0a; border-color: #0a0a0a">{{ icon(k, 64, true) }}</span>
      </div>
    </div>
  </div>
</section>
{%- endfor %}

<h2 style="margin-top: 48px">Prior approaches</h2>
<p>Other drawings explored along the way, kept for reference.</p>
<h3 class="lp-round">Round 6 · join as M, straight</h3>
<div class="lp-strip" style="align-items: center; gap: 28px; margin-bottom: 8px">
  {{ joinOdWordmark("straight", false, 26) }}{{ joinOdWordmark("straight", false, 26, 300) }}
</div>
<h3 class="lp-round">Round 5 · other drawings of the join</h3>
<div class="lp-strip" style="align-items: center; gap: 28px; margin-bottom: 28px">
  {%- for id in ["outline", "layered"] %}{{ joinWordmark(id, false, 26) }}{% endfor %}
</div>

<section class="lp-concept">
  <h2>Current logo (1998)</h2>
  <div class="lp-current">
    <img src="/assets/sigmod-current.png" alt="Current ACM SIGMOD logo" width="200" height="64">
    <p>Designed by Jun Yang (Stanford) as the winning entry of the 1998 logo contest. The only file still online is a 200×64 PNG; the vector and high-resolution versions linked from the <a href="https://sigmod.org/about-sigmod/sigmod-logo-renderings/">logo renderings page</a> no longer exist.</p>
  </div>
</section>

<h3 class="lp-round">Round 4</h3>
<div class="lp-strip" style="align-items: center; gap: 28px">
  {%- for id in ["points", "stream", "graph", "strata", "sigmao"] %}{{ r4Lockup(id, "h", false, 20) }}{% endfor %}
</div>

<h3 class="lp-round">Rounds 1–3</h3>
<div class="lp-strip" style="align-items: center; gap: 28px">
  {%- for id in ["sigmao", "join", "tuple", "cyl", "tile"] %}{{ wordmark(id, blue, "#111827", 24) }}{% endfor %}
</div>
<div class="lp-strip" style="margin-top: 18px">
  {%- for id in ["sigma", "join", "index", "levels", "hist", "stack", "cells", "disc"] %}{{ mark(id, blue, "SIGMOD", 36) }}{% endfor %}
</div>

<h2>Next steps</h2>
<ul class="lp-notes">
  <li>Choose one of the four candidates. A designer then refines it, tunes the spacing around the custom letter, and outlines the text so the logo no longer depends on a web font.</li>
  <li>Publish SVG, PNG and EPS files on the logo renderings page and update its usage rules.</li>
  <li>The ACM brand guidelines apply to SIG logos, so check the final mark with ACM before switching.</li>
  <li>The blue-to-teal gradient is a placeholder. The join also works in a single flat colour for print and one-colour uses.</li>
  <li>Dropping “ACM” from the logo is a design choice; ACM’s SIG branding rules may still ask for “ACM” nearby (for example in the tagline or footer), which the site already does.</li>
</ul>
